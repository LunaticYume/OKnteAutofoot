{
  "version": 1,
  "note": "养成需求表：从 from 级升到 to 级所需的材料。材料用通用键（ability_mat/arc_mat/console_mat 会按角色选择的序号换算成具体材料）。表为空时可在角色的『直接材料需求』里手填缺口。数据有出入时以面板编辑为准。",
  "generic_materials": {
    "exp_char": "角色经验（按角色的经验材料）",
    "exp_arc": "弧盘经验",
    "coin": "甲硬币",
    "ability_mat": "异能升级材料（按角色选择的一~伍）",
    "arc_mat": "弧盘突破材料（按角色选择的一~伍）",
    "console_mat": "空幕（按角色选择的一~陆）"
  },
  "tracks": {
    "char_level": {
      "name": "角色等级",
      "max": 80,
      "ladder": [
        {"from": 1, "to": 80, "items": {"exp_char": 0, "coin": 0}}
      ]
    },
    "ability_level": {
      "name": "异能等级",
      "max": 12,
      "ladder": [
        {"from": 1, "to": 12, "items": {"ability_mat": 0, "coin": 0}}
      ]
    },
    "arc_level": {
      "name": "弧盘等级",
      "max": 60,
      "ladder": [
        {"from": 1, "to": 60, "items": {"exp_arc": 0, "arc_mat": 0, "coin": 0}}
      ]
    },
    "console_level": {
      "name": "空幕等级",
      "max": 12,
      "ladder": [
        {"from": 1, "to": 12, "items": {"console_mat": 0, "coin": 0}}
      ]
    }
  },
  "sample": {
    "说明": "ladder 条目格式示例（把 0 改成实际数值即可生效，可添加多段）：",
    "from": 40,
    "to": 50,
    "items": {"exp_char": 120, "coin": 30}
  }
}
