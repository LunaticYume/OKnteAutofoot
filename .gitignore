# Python 运行产物
__pycache__/
*.pyc

# 构建产物
dist/
tools/_build/
*.tmp

# 本机工具状态
.zcode/
.mimosa/
*.log
# CWD 漂移的运行时日志目录（如游戏启动器/外部组件按 CWD 写 logs/，2026-11-21）
logs/

# 用户/运行时数据（只保留 data/ 下的数据表：materials/yields/requirements/game_data/mysqil）
data/backups/
data/*.bak
data/*.corrupt
data/*.tmp
data/runtime.json
data/state.json
data/state.json.bak

# wiki 抓取原始备份（正式快照 mysqil/*.json 保留入库，.bak 原始页不入库）
data/mysqil/*.bak

# 图鉴覆盖层（用户手录的角色/武器；属用户数据不入库）
data/game_data_custom.json
data/game_data_custom.json.bak

# OCR 布局标定（运行时标定/自愈生成的用户数据，不入库）
data/ocr_layout.json
# 旧版 OCR 标定文件名（现行代码已无该文件名的生产者；防旧机数据回流时误入库）
data/char_ocr_layout.json
# Edge 壳浏览器用户数据（源码态回落时 main.py 在仓库 data/ 下建 profile；绝不入库）
data/edge_profile/

# 塔吉多个人凭证（access/refresh token + 设备指纹；只存本机，绝不入库）
data/tajiduo_token.json
data/tajiduo_token.json.bak
data/tajiduo_token.json.tmp

# 面板令牌（SEC-05：每次启动重生成；只存本机，绝不入库）
data/panel_token.json
data/panel_token.json.bak
data/panel_token.json.tmp

# 提权辅助进程握手配置（SEC-10 运行时生成，含 token 与 parent_pid；只存本机，绝不入库）
data/elev_helper_config-*.json
# 提权辅助进程端点文件（运行时生成，panel 退出自清；gitignore 防瞬态噪音——B2.7A 复核发现）
data/elev_helper_endpoint-*.json

# 塔吉多同步原始 payload 诊断留存（含个人角色面板数据；只存本机，绝不入库）
data/tajiduo_last_payload.json
data/tajiduo_last_payload.json.bak
data/tajiduo_last_payload.json.tmp

# 塔吉多抽卡本地累积存档（个人抽卡记录；只存本机，绝不入库）
data/gacha_history.json
data/gacha_history.json.bak
data/gacha_history.json.tmp
data/gacha_history.json.corrupt

# 执行计划选项覆盖（面板 POST /api/oknte/plan 保存的用户偏好；只存本机，绝不入库）
data/oknte_plan.json
data/oknte_plan.json.bak
data/oknte_plan.json.tmp

# 攻略站同步快照（sites_fetch 运行时抓取生成：guide_sites.json + .bak 轮转；缓存数据不入库）
# 例外：独立来源交叉核对快照（source_crosscheck.json）为合规证据链，入库
data/sites/*
!data/sites/source_crosscheck.json

# 角色头像缓存（nteguide 下载的本机运行时数据；manifest+webp/avif 均不入库）
data/avatars/

# 审计报告（含未修复缺陷披露与内部架构细节；公开仓库不推送，只存本机）
audit/

# 测试临时根（代理测试/隔离实验专用，轮末整目录清空；保持 C 盘干净——见 AGENTS.md）
.tmp/

# 关键测试痕迹归档（验证/验收/E2E/探针产物；先归档再清 C 盘，长期保留不入库）
.testarchive/
